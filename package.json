{
  "name": "doce-maria-site",
  "private": true,
  "type": "module",
  "description": "Site de encomendas da Doce Maria (bolos, doces e salgados), Ipsep, Recife.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "validar": "node scripts/validar-catalogo.mjs",
